timestep 0.001
thermo 10000
if "${phase} == amorph" then   "velocity all create 7000 ${seed} dist gaussian"   "fix melt all npt temp 3500 3500 0.1 iso 0.0 0.0 1.0"   "run 50000" "unfix melt"   "fix quench all npt temp 3500 ${T} 0.1 iso 0.0 0.0 1.0"   "run 100000" "unfix quench"   "fix npt all npt temp ${T} ${T} 0.1 iso 0.0 0.0 1.0"   "run 50000" "unfix npt" else   "velocity all create $(2*v_T) ${seed} dist gaussian"   "fix npt all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0"   "run 50000" "unfix npt"
velocity all create $(2*v_T) ${seed} dist gaussian
velocity all create 1400 ${seed} dist gaussian
velocity all create 1400 2004 dist gaussian
fix npt all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0
fix npt all npt temp 700 ${T} 0.1 aniso 0.0 0.0 1.0
