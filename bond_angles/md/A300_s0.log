# Structure-only rebuild of the Phase C production probes and matching
# crystal rows (phase_c/production): same cell, potential, seed and
# preparation as in.mp_amorph (phase "amorph") or in.mp_kappa2 (phase
# "crystal") up to the end of equilibration, then 10 ps NVT sampling with a
# dump every 1 ps. No heat flux, no kappa. Not a registered run.
variable x     index 0.5
variable T     index 300
variable seed  index 2003
variable phase index crystal
variable out   index s
units metal
boundary p p p
variable a0 equal 5.431+(5.658-5.431)*v_x
lattice diamond ${a0}
lattice diamond 5.5445
Lattice spacing in x,y,z = 5.5445 5.5445 5.5445
region box block 0 4 0 4 0 24
create_box 2 box
Created orthogonal box = (0 0 0) to (22.178 22.178 133.068)
  1 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 3072 atoms
  using lattice units in orthogonal box = (0 0 0) to (22.178 22.178 133.068)
  create_atoms CPU = 0.001 seconds
set type 1 type/fraction 2 ${x} ${seed}
set type 1 type/fraction 2 0.5 ${seed}
set type 1 type/fraction 2 0.5 2003
Setting atom values ...
  1529 settings made for type/fraction
mass 1 28.0855
mass 2 72.63
pair_style tersoff
pair_coeff * * SiCGe_GeC.tersoff Si(D) Ge
Reading tersoff potential file SiCGe_GeC.tersoff with DATE: 2009-03-18
timestep 0.001
thermo 10000
if "${phase} == amorph" then   "velocity all create 7000 ${seed} dist gaussian"   "fix melt all npt temp 3500 3500 0.1 iso 0.0 0.0 1.0"   "run 50000" "unfix melt"   "fix quench all npt temp 3500 ${T} 0.1 iso 0.0 0.0 1.0"   "run 100000" "unfix quench"   "fix npt all npt temp ${T} ${T} 0.1 iso 0.0 0.0 1.0"   "run 50000" "unfix npt" else   "velocity all create $(2*v_T) ${seed} dist gaussian"   "fix npt all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0"   "run 50000" "unfix npt"
velocity all create 7000 ${seed} dist gaussian
velocity all create 7000 2003 dist gaussian
fix melt all npt temp 3500 3500 0.1 iso 0.0 0.0 1.0
run 50000
