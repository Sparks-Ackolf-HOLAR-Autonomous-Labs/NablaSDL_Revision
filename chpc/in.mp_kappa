# Muller-Plathe reverse-NEMD kappa point for Si1-xGex, SiCGe.tersoff.
# Input-deck port of pilot/src/mp_kappa.py (same protocol, same constants)
# for CHPC module LAMMPS via MPI. Variables set from the command line:
#   -var x <x_ge> -var T <K> -var ncz <cells> -var seed <int>
#   -var pot <path to SiCGe.tersoff> -var out <output prefix>
# Protocol: NPT equil 50 ps, MP warmup 100 ps (discarded), production
# 500 ps, 20 z-bins, swaps every 50 steps. Analysis in analyze_mp.py.

variable x    index 0.5
variable T    index 300
variable ncz  index 24
variable seed index 20260925
variable pot  index SiCGe.tersoff
variable out  index mp_out

units metal
boundary p p p
variable a0 equal 5.431+(5.658-5.431)*v_x
lattice diamond ${a0}
region box block 0 4 0 4 0 ${ncz}
create_box 2 box
create_atoms 1 box
if "${x} > 0" then "set type 1 type/fraction 2 ${x} ${seed}"
mass 1 28.0855
mass 2 72.63
pair_style tersoff
pair_coeff * * ${pot} Si(D) Ge

timestep 0.001
thermo 10000
velocity all create $(2*v_T) ${seed} dist gaussian
fix npt all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0
run 50000
unfix npt

fix nve all nve
fix flux all thermal/conductivity 50 z 20
run 100000
print "MPT_EWARM $(f_flux:%.6f)"

compute bins all chunk/atom bin/1d z lower 0.05 units reduced
fix prof all ave/chunk 10 100 1000 bins temp ave running overwrite file ${out}.profile
run 500000
print "MPT_EPROD $(f_flux:%.6f)"
print "MPT_BOX $(lx:%.4f) $(ly:%.4f) $(lz:%.4f)"
print "MPT_NATOMS $(atoms)"
print "MPT_META x ${x} T ${T} ncz ${ncz} seed ${seed} prod_steps 500000"
