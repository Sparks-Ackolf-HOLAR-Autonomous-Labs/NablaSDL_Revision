# Green-Kubo kappa for pure Si with Stillinger-Weber, on CHPC module
# LAMMPS. Phase B follow-up item 4 (endpoint strategy): the direct MP
# method is hopelessly ballistic for pure Si/Ge at affordable sizes, and
# Green-Kubo with Tersoff is impossible in stock LAMMPS (pair tersoff is
# CENTROID_NOTAVAIL, measured in the DGX pilot). pair sw DOES implement
# compute centroid/stress/atom (Surblys et al., PRE 2019), so this deck
# is the feasibility test for the "different potential for endpoints"
# option: homogeneous GK, no imposed gradient, no ballistic size wall.
# Variables:
#   -var T <K> -var ncell <cells> -var seed <int>
#   -var pot <path to Si.sw> -var out <output prefix>
# Protocol: NPT equil 50 ps, NVE settle 20 ps, GK production 2 ns with
# heat-flux autocorrelation to 40 ps (fix ave/correlate, running
# average). kappa integration in analyze_gk_sw.py from the .hcacf file;
# the in-deck trap() values are printed as a cross-check.

variable T     index 300
variable ncell index 6
variable seed  index 101
variable pot   index Si.sw
variable out   index gk_out

units metal
boundary p p p
lattice diamond 5.431
region box block 0 ${ncell} 0 ${ncell} 0 ${ncell}
create_box 1 box
create_atoms 1 box
mass 1 28.0855
pair_style sw
pair_coeff * * ${pot} Si

timestep 0.001
thermo 10000
velocity all create $(2*v_T) ${seed} dist gaussian
fix npt all npt temp ${T} ${T} 0.1 iso 0.0 0.0 1.0
run 50000
unfix npt
fix nve all nve
run 20000

# heat flux from centroid atomic stress (valid for many-body sw)
compute ke all ke/atom
compute pe all pe/atom
compute cs all centroid/stress/atom NULL virial
compute flux all heat/flux ke pe cs

variable s equal 5        # sample interval (steps)
variable p equal 8000     # correlation window: 8000 samples = 40 ps
variable d equal $(v_s*v_p)
fix JJ all ave/correlate ${s} ${p} ${d} c_flux[1] c_flux[2] c_flux[3] type auto file ${out}.hcacf ave running

# in-deck running kappa (metal units -> W/mK), LAMMPS GK doc formula
variable kB equal 1.3806504e-23
variable ev2j equal 1.602176634e-19
variable A2m equal 1.0e-10
variable ps2s equal 1.0e-12
variable convert equal ${ev2j}*${ev2j}/${ps2s}/${A2m}
variable scale equal ${convert}/${kB}/v_T/v_T/vol*${s}*dt
variable k11 equal trap(f_JJ[3])*${scale}
variable k22 equal trap(f_JJ[4])*${scale}
variable k33 equal trap(f_JJ[5])*${scale}

run 2000000
print "GKS_KXYZ $(v_k11:%.4f) $(v_k22:%.4f) $(v_k33:%.4f)"
print "GKS_KAVE $((v_k11+v_k22+v_k33)/3.0:%.4f)"
print "GKS_BOX $(lx:%.4f) $(ly:%.4f) $(lz:%.4f)"
print "GKS_NATOMS $(atoms)"
print "GKS_META T ${T} ncell ${ncell} seed ${seed} sample ${s} window_ps 40 prod_steps 2000000"
